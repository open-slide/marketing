{
  "name": "open-slide-marketing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#ui/*": "./src/ui/*",
    "#theme": "./src/theme.js"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "new:film": "node scripts/new-film.mjs",
    "new:image": "node scripts/new-image.mjs",
    "render": "node scripts/render.mjs",
    "render:draft": "node scripts/render.mjs --draft",
    "stills": "node scripts/render.mjs --stills",
    "snapshot": "node scripts/snapshot.mjs",
    "soundtrack": "node audio/synth.mjs",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "~1.63.0"
  },
  "packageManager": "pnpm@10.17.0"
}
